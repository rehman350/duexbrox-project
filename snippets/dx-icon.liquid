{%- comment -%}
  DUEXBROX inline icons.
  Usage: {% render 'dx-icon', name: 'arrow', class: 'dx-roll__a' %}
  Names: arrow, arrow-left, chev-left, chev-right, chev-down, plus, minus, share, ruler, close, menu, star, down
{%- endcomment -%}
{%- capture cls -%}{{ class | default: 'dx-ico' }}{%- endcapture -%}
{%- case name -%}
  {%- when 'arrow' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M3 12h17M14 6l6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M21 12H4M10 6l-6 6 6 6"/></svg>
  {%- when 'chev-left' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
  {%- when 'chev-right' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
  {%- when 'chev-down' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M5 9l7 7 7-7"/></svg>
  {%- when 'down' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M12 3v17M6 14l6 6 6-6"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'share' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M12 15V3M7.5 7.5 12 3l4.5 4.5M5 12v8h14v-8"/></svg>
  {%- when 'ruler' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M3 16.5 16.5 3 21 7.5 7.5 21z"/><path d="M7 12.5l1.8 1.8M10 9.5l1.8 1.8M13 6.5l1.8 1.8"/></svg>
  {%- when 'close' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'menu' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M3 8h18M3 16h18"/></svg>
  {%- when 'star' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg>
{%- endcase -%}

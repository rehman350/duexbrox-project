{%- comment -%} DUEXBROX statement banner: brand left, statement centre, collection label right. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="dx dx-stmt" style="--dx-stmt-bg: {{ s.bg }}; --dx-stmt-fg: {{ s.fg }};">
  <div class="dx-wrap dx-stmt__in">
    <p class="dx-stmt__side dx-label">{{ s.left | escape }}</p>
    <div class="dx-stmt__mid dx-rv">
      <h2 class="dx-stmt__h">{{ s.heading | escape | newline_to_br }}</h2>
      {%- if s.text != blank -%}
        <p class="dx-stmt__p">{{ s.text | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
    <p class="dx-stmt__side dx-stmt__side--r dx-label">{{ s.right | escape }}</p>
  </div>
</section>

{% stylesheet %}
  .dx-stmt {
    background: var(--dx-stmt-bg, #000);
    color: var(--dx-stmt-fg, #fff);
  }

  .dx-stmt__in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: clamp(220px, 13vw, 280px);
    padding-block: clamp(40px, 4vw, 64px);
  }

  .dx-stmt__side {
    font-size: clamp(11px, 0.75vw, 13px);
  }

  .dx-stmt__side--r {
    text-align: right;
  }

  .dx-stmt__mid {
    text-align: center;
  }

  .dx-stmt__h {
    font-family: var(--dx-fh);
    font-weight: 400;
    font-size: clamp(16px, 1.45vw, 26px);
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dx-stmt__p {
    margin-top: clamp(12px, 1vw, 18px);
    font-size: clamp(10px, 0.7vw, 12px);
    line-height: 2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  @media (max-width: 799px) {
    .dx-stmt__in {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 20px;
    }

    .dx-stmt__side,
    .dx-stmt__side--r {
      text-align: center;
    }

    .dx-stmt__mid {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DX Statement banner",
  "class": "dx-stmt-section",
  "settings": [
    { "type": "text", "id": "left", "label": "Left text", "default": "DUEXBROX" },
    { "type": "textarea", "id": "heading", "label": "Statement", "default": "NOT DESIGNED FOR TRENDS.\nDESIGNED FOR REPEAT WEAR." },
    { "type": "textarea", "id": "text", "label": "Supporting lines", "default": "OVERSIZED SILHOUETTES. FUNCTIONAL DETAILS.\nEVERYDAY UNIFORMS." },
    { "type": "text", "id": "right", "label": "Right text", "default": "COLLECTION 01" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "DX Statement banner" }]
}
{% endschema %}

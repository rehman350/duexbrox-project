{%- comment -%} DUEXBROX announcement bar: rotating messages with manual arrows. {%- endcomment -%}
{%- liquid
  assign msgs = section.blocks | where: 'type', 'message'
-%}
{%- if msgs.size > 0 -%}
  <div
    class="dx dx-ann"
    data-dx-ann
    data-speed="{{ section.settings.speed }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="Announcements"
    style="--dx-ann-bg: {{ section.settings.bg }}; --dx-ann-fg: {{ section.settings.fg }};"
  >
    <div class="dx-ann__in dx-wrap">
      {%- if msgs.size > 1 -%}
        <button type="button" class="dx-ann__btn" data-dx-ann-prev aria-label="Previous announcement">
          {%- render 'dx-icon', name: 'chev-left' -%}
        </button>
      {%- endif -%}
      <div class="dx-ann__track" aria-live="off">
        {%- for block in msgs -%}
          <p
            class="dx-ann__item{% if forloop.first %} is-on{% endif %}"
            data-dx-ann-item
            {% unless forloop.first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="dx-ul">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if msgs.size > 1 -%}
        <button type="button" class="dx-ann__btn" data-dx-ann-next aria-label="Next announcement">
          {%- render 'dx-icon', name: 'chev-right' -%}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .dx-ann {
    background: var(--dx-ann-bg, #111);
    color: var(--dx-ann-fg, #fff);
    position: relative;
    z-index: 60;
  }

  .dx-ann__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    gap: 12px;
    padding-inline: clamp(12px, 2.5vw, 48px);
  }

  .dx-ann__btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    flex: none;
    transition: opacity 0.3s;
  }

  .dx-ann__btn:hover {
    opacity: 0.6;
  }

  .dx-ann__btn svg {
    width: 18px;
    height: 18px;
  }

  .dx-ann__track {
    position: relative;
    flex: 1;
    display: grid;
    text-align: center;
    overflow: hidden;
  }

  .dx-ann__item {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--dx-fb);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 40px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(var(--dx-ann-dir, 1) * 60%));
    transition: opacity 0.5s var(--dx-ease), transform 0.5s var(--dx-ease), visibility 0s linear 0.5s;
  }

  .dx-ann__item.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.5s var(--dx-ease) 0.1s, transform 0.5s var(--dx-ease) 0.1s, visibility 0s;
  }

  .dx-ann__item.is-out {
    transform: translateY(calc(var(--dx-ann-dir, 1) * -60%));
  }

  @media (min-width: 900px) {
    .dx-ann__item {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DX Announcement bar",
  "class": "dx-ann-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free Shipping" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DX Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free Shipping" } },
        { "type": "message", "settings": { "text": "Get Yours Now" } }
      ]
    }
  ]
}
{% endschema %}

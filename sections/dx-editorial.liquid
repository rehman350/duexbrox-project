{%- comment -%}
  DUEXBROX Editorial: homepage row of three, or the full masonry gallery for the Editorial page.
  Masonry uses CSS columns, so images flow down each column like the reference (tall + short stacks).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tag = 'h2'
  if s.layout == 'masonry' and s.page_title
    assign tag = 'h1'
  endif
-%}
<section class="dx dx-ed dx-ed--{{ s.layout }}" aria-labelledby="DxEdH-{{ section.id }}">
  <div class="dx-wrap">
    <div class="dx-head">
      <div>
        <{{ tag }} class="dx-h {% if tag == 'h1' %}dx-h--page{% else %}dx-h--sec{% endif %}" id="DxEdH-{{ section.id }}">{{ s.heading | escape }}</{{ tag }}>
        {%- if s.subtitle != blank -%}<p class="dx-ed__sub">{{ s.subtitle | escape }}</p>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        {%- render 'dx-roll', label: s.link_label, url: s.link -%}
      {%- endif -%}
    </div>

    <ul class="dx-ed__grid" role="list" style="--dx-ed-cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign shape = b.shape
          if s.layout == 'row'
            assign shape = 'row'
          endif
          if s.layout == 'row'
            assign sizes = '(min-width: 700px) 33vw, 100vw'
          else
            assign sizes = '(min-width: 1100px) 25vw, (min-width: 600px) 50vw, 100vw'
          endif
          assign ph = forloop.index | modulo: 2 | plus: 1
        -%}
        <li class="dx-ed__item dx-ed__item--{{ shape }} dx-rv" style="--dx-d: {{ forloop.index0 | modulo: 4 | times: 0.07 }}s" {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a href="{{ b.link }}" class="dx-ed__link">{%- endif -%}
          <div class="dx-media dx-zoom dx-ed__media">
            {%- assign ph_name = 'lifestyle-' | append: ph -%}
            {%- render 'dx-img', image: b.image, preview: b.preview, ph: ph_name, widths: '400,600,800,1100,1600', sizes: sizes, alt: b.alt -%}
          </div>
          {%- if b.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .dx-ed {
    padding-block: calc(var(--dx-sec) * 0.5) var(--dx-sec);
  }

  .dx-ed--masonry {
    padding-block: clamp(40px, 5vw, 84px) clamp(56px, 6vw, 96px);
  }

  .dx-ed__sub {
    margin-top: 12px;
    font-size: clamp(14px, 1vw, 18px);
    color: #4a4a4a;
  }

  .dx-ed__grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dx-ed__link {
    display: block;
  }

  /* Homepage row */
  .dx-ed--row .dx-ed__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--dx-gap);
  }

  .dx-ed__item--row .dx-ed__media {
    aspect-ratio: 2 / 1;
  }

  /* Editorial page masonry */
  .dx-ed--masonry .dx-ed__grid {
    columns: var(--dx-ed-cols, 4);
    column-gap: var(--dx-gap);
  }

  .dx-ed--masonry .dx-ed__item {
    break-inside: avoid;
    margin-bottom: var(--dx-gap);
  }

  .dx-ed__item--portrait .dx-ed__media { aspect-ratio: 3 / 4; }
  .dx-ed__item--tall .dx-ed__media { aspect-ratio: 3 / 4; }
  .dx-ed__item--landscape .dx-ed__media { aspect-ratio: 2 / 1; }
  .dx-ed__item--wide .dx-ed__media { aspect-ratio: 16 / 9; }
  .dx-ed__item--square .dx-ed__media { aspect-ratio: 1 / 1; }
  .dx-ed__item--natural .dx-ed__media { aspect-ratio: auto; }
  .dx-ed__item--natural .dx-ed__media img { position: static; height: auto; }

  @media (max-width: 1099px) {
    .dx-ed--masonry .dx-ed__grid {
      columns: 2;
    }
  }

  @media (max-width: 699px) {
    .dx-ed--row .dx-ed__grid {
      grid-template-columns: 1fr;
    }

    .dx-ed--row .dx-ed__item--row .dx-ed__media {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 479px) {
    .dx-ed--masonry .dx-ed__grid {
      columns: 1;
    }

    .dx-ed--masonry .dx-ed__item--portrait .dx-ed__media,
    .dx-ed--masonry .dx-ed__item--tall .dx-ed__media {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DX Editorial",
  "class": "dx-ed-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "row", "label": "Row of three (homepage)" },
        { "value": "masonry", "label": "Masonry gallery (Editorial page)" }
      ],
      "default": "row"
    },
    { "type": "range", "id": "columns", "label": "Masonry columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EDITORIAL" },
    { "type": "checkbox", "id": "page_title", "label": "Heading is the page title (masonry layout)", "default": true },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "VIEW ALL EDITORIAL" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "preview", "label": "Temporary preview image", "info": "Bundled preview photo shown only while Image is empty. Clear it, or pick a real image, to remove it." },
        { "type": "text", "id": "alt", "label": "Alt text (if the image has none)" },
        {
          "type": "select", "id": "shape", "label": "Shape (masonry)",
          "options": [
            { "value": "portrait", "label": "Tall portrait" },
            { "value": "landscape", "label": "Short landscape" },
            { "value": "wide", "label": "Wide 16:9" },
            { "value": "square", "label": "Square" },
            { "value": "natural", "label": "Original ratio" }
          ],
          "default": "portrait"
        },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DX Editorial",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}

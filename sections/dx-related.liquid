{%- comment -%}
  "You May Also Like These": Shopify product recommendations (or a fallback collection),
  loaded through the Section Rendering API so it never slows the product page.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign items = recommendations.products
  assign fb = s.fallback
  if fb == blank
    assign fb = collections['duexbrox']
  endif
  if fb == blank or fb.products_count == 0
    assign fb = collections.all
  endif
-%}
<section
  class="dx dx-rel"
  data-dx-related
  data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ s.limit }}&section_id={{ section.id }}&intent=related"
>
  {%- if recommendations.performed -%}
    {%- if items.size > 0 -%}
      <div class="dx-wrap">
        <h2 class="dx-rel__h">{{ s.heading | escape }}</h2>
        <ul class="dx-rel__grid" role="list" style="--dx-rel-n: {{ s.limit }};">
          {%- for p in items limit: s.limit -%}
            <li class="dx-rv" style="--dx-d: {{ forloop.index0 | times: 0.08 }}s">
              {%- render 'dx-card', product: p, sizes: '(min-width: 900px) 30vw, 50vw' -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} Shown until (or instead of) Shopify recommendations: products from the fallback collection, minus this one. {%- endcomment -%}
    {%- assign shown = 0 -%}
    {%- capture cards -%}
      {%- for p in fb.products limit: 12 -%}
        {%- if p.id == product.id or shown >= s.limit -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <li class="dx-rv" style="--dx-d: {{ shown | times: 0.08 }}s">
          {%- render 'dx-card', product: p, sizes: '(min-width: 900px) 30vw, 50vw' -%}
        </li>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if shown > 0 -%}
      <div class="dx-wrap">
        <h2 class="dx-rel__h">{{ s.heading | escape }}</h2>
        <ul class="dx-rel__grid" role="list" style="--dx-rel-n: {{ s.limit }};">{{ cards }}</ul>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<script>
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (!el || !el.dataset.url) return;
    fetch(el.dataset.url)
      .then((r) => r.text())
      .then((html) => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const fresh = doc.querySelector('[data-dx-related]');
        // Only swap in real recommendations; otherwise keep the fallback products already on the page.
        if (fresh && fresh.querySelector('.dx-card')) {
          el.innerHTML = fresh.innerHTML;
          window.DX?.boot?.(el);
        }
      })
      .catch(() => {});
  })();
</script>

{% stylesheet %}
  .dx-rel {
    padding-block: 0 clamp(56px, 6vw, 110px);
  }

  .dx-rel__h {
    text-align: center;
    font-family: var(--dx-fh);
    font-weight: 400;
    font-size: clamp(18px, 1.6vw, 28px);
    margin-bottom: clamp(28px, 3vw, 56px);
  }

  .dx-rel__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--dx-rel-n, 3), minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 24px);
  }

  /* Phones: a swipeable row (two cards and a peek of the next) instead of a grid with an orphan card. */
  @media (max-width: 699px) {
    .dx-rel__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 44%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--dx-gutter) * -1);
      padding-inline: var(--dx-gutter);
      scroll-padding-inline: var(--dx-gutter);
    }

    .dx-rel__grid::-webkit-scrollbar {
      display: none;
    }

    .dx-rel__grid > li {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DX Related products",
  "class": "dx-rel-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like These" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "collection", "id": "fallback", "label": "Fallback collection", "info": "Used when Shopify has no recommendations yet (new stores). Defaults to the duexbrox collection, then all products." }
  ],
  "presets": [{ "name": "DX Related products" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}

{%- comment -%} DUEXBROX Contact page: black GET IN TOUCH panel + Shopify contact form. {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="dx dx-ct">
  <div class="dx-wrap">
    <nav class="dx-crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-current="page">{{ page.title | default: 'Contact' | escape }}</li>
      </ol>
    </nav>

    <div class="dx-ct__panel">
      <h1 class="dx-ct__h">{{ s.heading | escape }}</h1>
      <div class="dx-ct__cols">
        {%- for block in section.blocks -%}
          <div class="dx-ct__col" {{ block.shopify_attributes }}>
            <p class="dx-ct__label">{{ block.settings.label | escape }}</p>
            <div class="dx-ct__val">
              {%- case block.type -%}
                {%- when 'email' -%}
                  <a href="mailto:{{ block.settings.email }}" class="dx-ul dx-ul--on">{{ block.settings.email | escape }}</a>
                {%- when 'text' -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- when 'social' -%}
                  {%- if block.settings.instagram != blank -%}
                    <a href="{{ block.settings.instagram }}" class="dx-ul dx-ul--on" target="_blank" rel="noopener">Instagram</a>
                  {%- else -%}
                    <span>Instagram</span>
                  {%- endif -%}
                  <span aria-hidden="true">&middot;</span>
                  {%- if block.settings.tiktok != blank -%}
                    <a href="{{ block.settings.tiktok }}" class="dx-ul dx-ul--on" target="_blank" rel="noopener">TikTok</a>
                  {%- else -%}
                    <span>TikTok</span>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="dx-ct__form">
      {%- assign fid = 'DxContact-' | append: section.id -%}
      {%- render 'dx-contact-form', id: fid, heading: s.form_heading, button: s.button, ok: s.ok -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .dx-ct {
    padding-bottom: clamp(56px, 6vw, 110px);
  }

  .dx-ct__panel {
    max-width: 1340px;
    margin: clamp(24px, 2.6vw, 44px) auto 0;
    background: var(--dx-black);
    color: #fff;
    text-align: center;
    padding: clamp(48px, 5vw, 90px) clamp(20px, 4vw, 72px);
  }

  .dx-ct__h {
    font-family: var(--dx-fh);
    font-weight: 400;
    font-size: clamp(26px, 2.6vw, 48px);
    letter-spacing: 0.02em;
  }

  .dx-ct__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, auto));
    justify-content: center;
    gap: 28px clamp(28px, 4vw, 80px);
    margin-top: clamp(32px, 3.4vw, 56px);
  }

  .dx-ct__label {
    font-family: var(--dx-fh);
    font-size: clamp(10px, 0.75vw, 13px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #cfcfcf;
  }

  .dx-ct__val {
    margin-top: 14px;
    display: flex;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: clamp(15px, 1.1vw, 20px);
  }

  .dx-ct__form {
    max-width: 1170px;
    margin: clamp(56px, 6vw, 96px) auto 0;
  }

  @media (max-width: 999px) {
    .dx-ct__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 539px) {
    .dx-ct__cols {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DX Contact",
  "class": "dx-ct-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Panel heading", "default": "GET IN TOUCH" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "SEND US A MESSAGE" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "ok", "label": "Success message", "default": "Thanks for reaching out. We'll get back to you soon." }
  ],
  "blocks": [
    {
      "type": "email",
      "name": "Email",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "CUSTOMER SERVICE EMAIL" },
        { "type": "text", "id": "email", "label": "Email", "default": "hello.duexbrox@gmail.com" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "BUSINESS LOCATION" },
        { "type": "text", "id": "text", "label": "Text", "default": "United Arab Emirates" }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "SOCIAL MEDIA" },
        { "type": "url", "id": "instagram", "label": "Instagram URL" },
        { "type": "url", "id": "tiktok", "label": "TikTok URL" }
      ]
    }
  ],
  "presets": [{ "name": "DX Contact" }]
}
{% endschema %}
